<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- SRS Master List View -->
    <record id="view_srs_master_list" model="ir.ui.view">
        <field name="name">project.srs.master.list</field>
        <field name="model">project.srs.master</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>


    <!-- SRS Master Form View -->
    <record id="view_srs_master_form" model="ir.ui.view">
        <field name="name">project.srs.master.form</field>
        <field name="model">project.srs.master</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="description"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <!-- SRS Master Action -->
    <record id="action_srs_master" model="ir.actions.act_window">
        <field name="name">SRS Master</field>
        <field name="res_model">project.srs.master</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- SRS Master Menu -->
    <menuitem
        id="menu_srs_master"
        name="SRS Master"
        parent="project.menu_project_config"
        action="action_srs_master"
        sequence="50"
    />

</odoo>