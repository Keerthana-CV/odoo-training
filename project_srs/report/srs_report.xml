<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_report_project_srs" model="ir.actions.report">
        <field name="name">SRS Report</field>
        <field name="model">project.project</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">project_srs.report_project_srs_document</field>
        <field name="report_file">project_srs.report_project_srs_document</field>
        <field name="binding_model_id" ref="project.model_project_project"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_project_srs_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>SRS Report - <span t-field="doc.name"/></h2>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>SRS Name</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.srs_line_ids" t-as="line">
                                    <td><span t-field="line.srs_master_id.name"/></td>
                                    <td><span t-field="line.description"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>