<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view -->
    <record id="view_inventory_min_qty_list" model="ir.ui.view">
        <field name="name">inventory.min.qty.list</field>
        <field name="model">inventory.min.qty</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_ids" widget="many2many_tags"/>
                <field name="min_qty"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_inventory_min_qty_form" model="ir.ui.view">
        <field name="name">inventory.min.qty.form</field>
        <field name="model">inventory.min.qty</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="min_qty"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="product_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_inventory_min_qty" model="ir.actions.act_window">
        <field name="name">Minimum Quantity (Product Wise)</field>
        <field name="res_model">inventory.min.qty</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu under Inventory > Configuration -->
    <menuitem id="menu_inventory_min_qty"
              name="Minimum Quantity (Product Wise)"
              parent="stock.menu_stock_config_settings"
              action="action_inventory_min_qty"
              sequence="50"/>

</odoo>