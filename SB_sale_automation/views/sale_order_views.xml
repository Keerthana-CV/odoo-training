<odoo>

    <record id="sale_order_auto_confirm_view"
            model="ir.ui.view">

        <field name="name">sale.order.auto.confirm</field>
        <field name="model">sale.order</field>

        <field name="inherit_id"
               ref="sale.view_order_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']"
                   position="after">

                <field name="auto_confirm"/>

            </xpath>

        </field>

    </record>

</odoo>