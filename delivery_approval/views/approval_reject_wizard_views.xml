<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_approval_reject_wizard_form" model="ir.ui.view">
        <field name="name">delivery.approval.reject.wizard.form</field>
        <field name="model">delivery.approval.reject.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="picking_id" invisible="1"/>
                    <field name="remarks"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Reject"
                            type="object" class="btn-danger"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>