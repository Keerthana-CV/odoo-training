<odoo>
    <record id="view_sale_return_line_wizard_form" model="ir.ui.view">
        <field name="name">sale.return.line.wizard.form</field>
        <field name="model">sale.return.line.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Lines to Return">
                <field name="return_order_id" invisible="1"/>
                <field name="origin_sale_order_id" invisible="1"/>
                <field name="line_ids">
                    <list editable="bottom" create="false" delete="false">
                        <field name="origin_line_id" column_invisible="1"/>
                        <field name="selected"/>
                        <field name="product_id" readonly="1"/>
                        <field name="ordered_qty" readonly="1"/>
                        <field name="already_returned_qty" readonly="1"/>
                        <field name="max_returnable_qty" readonly="1"/>
                        <field name="return_qty"/>
                   </list>
                </field>
                <footer>
                    <button name="action_confirm_copy" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>