<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Create list view -->
    <record id="view_college_student_list" model="ir.ui.view">
        <field name="name">college.student.list</field>
        <field name="model">college.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="admission_number"/>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="email"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <!-- Create form view -->
    <record id="view_college_student_form" model="ir.ui.view">
        <field name="name">college.student.form</field>
        <field name="model">college.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <header>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-success"
                            invisible="state != 'draft'"/>

                    <button name="action_draft"
                            string="Set to Draft"
                            type="object"
                            class="btn-danger"
                            invisible="state != 'confirm'"/>

                    <button name="action_print_student"
                            string="Print"
                            type="object"
                            class="btn-primary"/>

                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="admission_number"/>
                            <field name="admission_date"/>
                            <field name="first_name"/>
                            <field name="last_name"/>
                        </group>

                        <group>
                            <field name="father_name"/>
                            <field name="mother_name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="hide_address"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Address" invisible="hide_address">
                            <group>
                                <group>
                                    <field name="communication_address"/>
                                    <field name="street"/>
                                    <field name="street2"/>
                                </group>

                                <group>
                                    <field name="city"/>
                                    <field name="zip"/>
                                    <field name="country_id"/>
                                    <field name="state_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- window action -->
    <record id="action_college_erp" model="ir.actions.act_window">
        <field name="name">College ERP</field>
        <field name="res_model">college.student</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Student
            </p>
        </field>
    </record>

</odoo>