<odoo>

    <record id="view_sale_order_form_inherit_address"
            model="ir.ui.view">
        <field name="name">sale.order.form.address</field>
        <field name="model">sale.order</field>

        <field name="inherit_id"
               ref="sale.view_order_form"/>

        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">

                <page string="Address" invisible="state != 'sale'">

                    <group>
                        <group>
                            <field name="communication_address"/>
                            <field name="street"/>
                            <field name="street2"/>
                        </group>

                        <group>
                            <field name="city"/>
                            <field name="zip"/>
                            <field name="country_id"/>
                            <field name="state_id"/>
                        </group>
                    </group>

                </page>

            </xpath>

        </field>
    </record>

</odoo>